# proto-file: vasdk/nlu/entity.proto
# proto-message: vasdk.nlu.EntityPack
#
# US states and DC: values in snake_case, the postal code as an attribute ($form.state.code).
# Postal codes aren't synonyms: many are words ("in", "or", "me", "ok").
name: "us_state"
description: "a US state"
entity_types {
  name: "us_state"
  description: "a US state"
  list {
      values { value: "alabama" spoken: "Alabama" attributes { fields { key: "code" value { string_value: "AL" } } } }
