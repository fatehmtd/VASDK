# proto-file: vasdk/flow/agent.proto
# proto-message: vasdk.flow.Agent
#
# A garage assistant with no LLM: book a service, hear the hours, or reach a person.
#   vasdk_agentc chat VASDK_APP/agents/garage-menu/agent.txtpb
#   vasdk_agentc try VASDK_APP/agents/garage-menu/agent.txtpb "my tyres are flat"
#   VASDK_Pipeline --agent VASDK_APP/agents/garage-menu/agent.txtpb
schema_version: 1
name: "garage-menu"
locale: "en-US"
start_flow: "main"

# Kept for the whole conversation. The app sets the tier (Session::setSessionParam), e.g. from a CRM;
# try it with: vasdk_agentc chat agent.txtpb --session tier=gold
session_params { name: "tier"    type: STRING default { string_value: "standard" } }
session_params { name: "service" type: STRING }
session_params { name: "day"     type: STRING }
session_params { name: "time"    type: STRING }

goal_files: ["goals/booking.txtpb"]   # what the booking form asks for

entity_types {
  name: "service"
  description: "A service the garage offers"
  list {
    values {
      value: "oil_change" spoken: "an oil change"
      synonyms: ["oil change", "oil", "change the oil", "lube"]
      attributes { fields { key: "price" value { number_value: 49 } } fields { key: "minutes" value { number_value: 30 } } }
    }
    values {
      value: "tire_repair" spoken: "a tire repair"
      synonyms: ["tire", "tires", "tyre", "tyres", "flat", "flattire", "puncture"]   # STT may join "flat tire"
      attributes { fields { key: "price" value { number_value: 89 } } fields { key: "minutes" value { number_value: 45 } } }
    }
  }
}

# The times still free. These are the defaults; an app replaces them for each conversation with
# Session::setEntityValues("available_time", ...), e.g. from its calendar.
entity_types {
  name: "available_time"
  dynamic: true
  list {
    values { value: "09:00" spoken: "9 AM"  synonyms: ["9", "nine", "9 am", "morning"] }
    values { value: "11:00" spoken: "11 AM" synonyms: ["11", "eleven", "11 am"] }
    values { value: "14:00" spoken: "2 PM"  synonyms: ["2", "two", "2 pm", "afternoon"] }
  }
}

intents { name: "book"    examples: ["book", "appointment", "schedule", "bring my car in", "service"] }
intents { name: "price"   examples: ["how much", "price", "cost", "costs"] }
intents { name: "hours"   examples: ["hours", "open", "close", "closing"] }
intents { name: "person"  examples: ["person", "human", "agent", "representative", "someone"] }
intents { name: "goodbye" examples: ["bye", "goodbye", "that's all", "nothing else"] }
intents { name: "help"    examples: ["help", "what can you do", "what do you do", "options", "explain"] }
intents { name: "hello"   examples: ["hello", "hi", "hey"] }
intents { name: "back"    examples: ["back", "main menu", "start over", "never mind"] }
intents { name: "yes"     examples: ["yes", "yeah", "yep", "sure", "go ahead"] }
intents { name: "no"      examples: ["no", "nope", "nothing", "that's all"] }

# Works on every page: hours, prices, a person, goodbye; silence and repeated misunderstandings.
envelopes: ["standard"]
envelope_defs {
  name: "standard"
  routes { intent: "hours" steps { say { text: "We're open 8 to 6, Monday to Saturday." } } }   # then the page's question again
  routes { intent: "price" target: "flow:prices" }   # a digression: back to where it was asked
  routes { intent: "person" target: "flow:handoff" }
  routes { intent: "goodbye" steps { say { text: "Thanks for calling. Goodbye!" } } target: "END_SESSION" }
  handlers { event: "no-input" steps { say { text: ["Are you still there?", "Hello?"] } } }
  handlers { event: "max-reprompts" steps { say { text: "Let me get someone to help you." } } target: "flow:handoff" }
  settings { no_input_ms: 8000 max_reprompts: 2 }
}

flows {
  name: "main"
  start_page: "welcome"

  pages {
    name: "welcome"
    on_enter { branch { if: "$session.tier = 'gold'" then { say { text: "Welcome back, gold member." } } } }
    on_enter { ask { say { text: "Hi, this is Acme Garage. Would you like to book a service, hear our hours, or talk to a person?" } } }
    routes { intent: "book" target: "booking" }   # "book an oil change": the form gets the service on the way in
    routes {   # here, a price leads on to booking (the envelope's price route is for the other pages)
      intent: "price"
      entity: "@service"
      steps { say { text: "$entity takes about $entity.minutes minutes and costs $entity.price dollars." } }
      steps { ask { say { text: "Would you like to book it?" } } }
    }
    routes {
      intent: "help"
      steps { say { text: "I can book an oil change or a tire repair, tell you our prices and opening hours, or put you through to a person." } }
      steps { ask { say { text: "What would you like?" } } }
    }
    routes { intent: "yes" target: "booking" }        # "would you like to book it?"
    routes { intent: "hello" target: "CURRENT_PAGE" }  # last: "hi, I'd like to book" still books
    routes { entity: "@service" target: "booking" }   # just naming one: "my tyres are flat"
  }

  # Asks for the service, day, time and phone number, reads them back, and books on a yes.
  # Anything said on the way in ("an oil change on Tuesday") is already filled.
  pages {
    name: "booking"
    form { goal: "booking" }
    routes {
      condition: "$form.confirmed"
      steps { set { key: "$session.service" value: "$form.service.spoken" } }
      steps { set { key: "$session.day" value: "$form.day" } }
      steps { set { key: "$session.time" value: "$form.time.spoken" } }
      target: "booked"
    }
    routes { condition: "$form.failed" steps { say { text: "Let me get someone to help you with that." } } target: "flow:handoff" }
    routes { intent: "back" target: "welcome" }
  }

  pages {
    name: "booked"
    on_enter { say { text: "You're booked for $session.service, $session.day at $session.time." } }
    on_enter { branch { if: "$session.tier : ('gold', 'platinum')" then { say { text: "As a $session.tier member, there's no charge." } } } }
    on_enter { ask { say { text: "Is there anything else I can help with?" } } }
    routes { intent: "no" steps { say { text: "Great, see you then. Goodbye!" } } target: "END_SESSION" }
    routes { intent: "yes" target: "welcome" }
  }
}

# Prices, from any page; then back to where the question was asked.
flows {
  name: "prices"
  start_page: "answer"
  pages {
    name: "answer"
    on_enter {
      branch {
        if: "exists($nlu.entities.service)"
        then { say { text: "$nlu.entities.service costs $nlu.entities.service.price dollars." } }
        else { say { text: "An oil change is 49 dollars and a tire repair is 89." } }
      }
    }
    on_enter { goto { target: "END_FLOW" } }
  }
}

flows {
  name: "handoff"
  start_page: "transfer"
  pages {
    name: "transfer"
    on_enter { say { text: "Connecting you to a person now." } }
    on_enter { end {} }
  }
}
