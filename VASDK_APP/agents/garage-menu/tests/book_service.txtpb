# proto-file: vasdk/flow/test_case.proto
# proto-message: vasdk.flow.FlowTestCase
name: "book a tire service, then say goodbye"
turns { expect { page: "welcome" said_contains: "Acme Garage" expects_reply: true } }
turns { user: "I'd like to bring my car in" expect { page: "service" said_contains: "oil change or tires" } }
turns { user: "I have a flat" expect { page: "booking" said: "Which day works for you?" session { key: "service" value: "a tire repair" } } }
turns { user: "Tuesday" expect { said: "And what's the best number to reach you?" form { key: "day" value: "tuesday" } } }
turns { user: "five five five, one two three, four five six seven"
        expect { said: "So that's a tire repair, tuesday, and we'll call you at 555-123-4567. Shall I book it?" form { key: "confirmed" value: "false" } } }
turns { user: "yes please"
        expect { page: "booked" said: "You're booked for a tire repair, tuesday at 9 AM. Is there anything else I can help with?" session { key: "day" value: "tuesday" } } }
turns { user: "no that's all thanks" expect { said_contains: "goodbye" ends_session: true expects_reply: false } }
turns { user: "hours please" expect { page: "welcome" said_contains: "8 to 6" } }   # the next conversation starts over
