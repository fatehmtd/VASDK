# proto-file: vasdk/flow/test_case.proto
# proto-message: vasdk.flow.FlowTestCase
name: "the booking form: a day on the way in, a closed day, the hours, and changing the answers"
turns { user: "book an oil change for sunday" expect { page: "booking" said: "Which day works for you?" form { key: "day" value: "" } } }
turns { user: "sunday" expect { matched: false said: "Sorry, which day? We're open Monday to Saturday." } }
turns { user: "what are your hours" expect { said: "We're open 8 to 6, Monday to Saturday. Which day works for you?" } }
turns { user: "saturday then" expect { said: "And what's the best number to reach you?" } }
turns { user: "555 123 4567" expect { said_contains: "an oil change, saturday" } }
turns { user: "no, make it friday" expect { said_contains: ["friday", "Shall I book it?"] form { key: "day" value: "friday" } } }
turns { user: "no" expect { said: "What would you like to change?" } }
turns { user: "the phone number" expect { said: "And what's the best number to reach you?" form { key: "phone" value: "" } } }
turns { user: "555 987 6543" expect { said_contains: "555-987-6543" } }
turns { user: "yep" expect { page: "booked" said_contains: "an oil change, friday at 9 AM" } }
