# proto-file: vasdk/flow/test_case.proto
# proto-message: vasdk.flow.FlowTestCase
name: "a gold member is welcomed back and not charged"
session { fields { key: "tier" value { string_value: "gold" } } }
turns { expect { page: "welcome" said_contains: "Welcome back, gold member." } }
turns { user: "book an oil change tomorrow morning"
        expect { page: "booking" said: "And what's the best number to reach you?" form { key: "service" value: "oil_change" } } }
turns { user: "555 123 4567" expect { said_contains: "Shall I book it?" } }
turns { user: "yes" expect { page: "booked" said_contains: ["booked for an oil change, tomorrow at 9 AM", "As a gold member, there's no charge."] } }
