# proto-file: vasdk/flow/test_case.proto
# proto-message: vasdk.flow.FlowTestCase
name: "greetings, help and naming the service on the welcome page"
turns { user: "hey what's up" expect { page: "welcome" said_contains: "Acme Garage" } }
turns { user: "explain what you can do for me" expect { page: "welcome" said_contains: "oil change or a tire service" expects_reply: true } }
turns { user: "Flattire." expect { page: "booked" said_contains: "booked for a tire repair" } }
