# proto-file: vasdk/flow/test_case.proto
# proto-message: vasdk.flow.FlowTestCase
name: "an answer that isn't understood repeats the question"
turns { expect { page: "welcome" } }
turns { user: "my windshield is cracked"
        expect { page: "welcome" matched: false expects_reply: true
                 said: "Sorry, I can't help with that here. Hi, this is Acme Garage. Would you like to book a service, hear our hours, or talk to a person?" } }
turns { user: "book" expect { page: "booking" } }
turns { user: "a car wash" expect { matched: false said: "We do oil changes and tire repairs. Which one do you need?" } }
turns { user: "go back to the main menu" expect { page: "welcome" said_contains: "book a service" } }
