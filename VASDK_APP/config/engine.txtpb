# proto-file: vasdk/engine/engine_config.proto
# proto-message: vasdk.engine.EngineConfig
#
# Engine config for VASDK_Pipeline:  VASDK_Pipeline --config VASDK_APP/config/engine.txtpb
# Provider ids that are not built into the binary are skipped in favour of `fallback`.
# ${NAME} reads an environment variable (the .env file is loaded first); ${NAME:-x} defaults to x.

# models_dir: "models"        # default: the models/ folder found next to the executable

providers {
  vad { id: "silero" }   # options { [type.googleapis.com/vasdk.providers.SileroOptions] { threshold: 0.6 } } hears quieter speech

  # Local: whistle, moonshine, parakeet. Cloud: gradium, soniox, deepgram, cartesia, fishaudio.
  stt { id: "whistle" fallback: ["parakeet", "moonshine"] }

  # Local: pocket, phonon, moss, supertonic. Cloud: gradium, soniox, deepgram, cartesia, fishaudio.
  tts { id: "phonon" fallback: ["pocket"] }   # voice and language: PHONON_TTS_VOICE, PHONON_TTS_LANG (default Easton, en)
  # Understanding (docs/reference/flows.md#entity-models): a sentence encoder for intents' paraphrases,
  # and what finds entities: gliner (VASDK_BUILD_GLINER_NER), tagger (needs minilm) or llm.
  # sentence_encoder { id: "minilm" }
  # entity_model { id: "gliner" }
  # End-of-turn model: smartturn-v3. Without one, the VAD's silence ends the turn.
  # turn { id: "smartturn-v3" }

  # A cloud provider with its key from the environment:
  # tts { id: "cartesia" options { [type.googleapis.com/vasdk.providers.CloudOptions] { api_key: "${CARTESIA_API_KEY}" } } }
}

# How quickly the assistant decides you've finished, and what counts as interrupting it.
# Values set here replace the preset's (and the --backchannel-* command-line options) one by one.
turn_taking {
  preset: BALANCED                    # SNAPPY for phone calls, PATIENT for people who pause to think
  # voice_activity { end_silence_ms: 400 pause_ms: 600 min_speech_ms: 250 barge_in_min_speech_ms: 150 }
  # Whistle only gives words once you stop: go quiet the moment you speak, resume if it was an "mm-hmm".
  backchannel { pending_playback: PAUSE commit_after_ms: 300 }   # defaults: DUCK, 600; also interrupt_words: ["stop", "wait"]
}

# Audio between the transport and the providers (the defaults are shown).
# audio {
#   input  { sample_rate: 16000 encoding: PCM_16 channels: 1 }
#   output { sample_rate: 16000 encoding: PCM_16 channels: 1 }
#   frame_ms: 100
# }

# Command-line --llm-* options override these; unset values fall back to LLM_* environment variables.
llm {
  endpoint: "${LLM_ENDPOINT:-}"
  model: "${LLM_MODEL:-}"
  # failure_replies: ["Sorry, I lost my train of thought. Could you say that again?"]   # said when a request fails
}
# More LLMs, by name, for the tasks that name one (docs/reference/engine-config.md, "Different LLMs for
# different tasks"). Each field left unset is llm's:
# llm_profiles { name: "fast"  model: "liquid/lfm2.5-1.2b" }        # a small model on the same endpoint
# llm_profiles { name: "smart" api: ANTHROPIC api_key: "${ANTHROPIC_API_KEY:-}" }
# understanding { llm_profile: "fast" }                             # the agent's intent check
