<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="14dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!--
        Avatar: pinned to the top-left corner of the row.
    -->
    <TextView
        android:id="@+id/tv_avatar"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:text="AI"
        android:textColor="@color/white"
        android:textSize="9sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@drawable/bg_ai_avatar"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!--
        Bubble: left-aligned, anchored right of the avatar.
        - layout_constrainedWidth="true" + wrap_content  → never exceeds available space
        - constraintHorizontal_bias="0.0"                → hugs the left when text is short
    -->
    <TextView
        android:id="@+id/tv_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bubble_assistant"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="11dp"
        android:paddingBottom="11dp"
        android:textColor="@color/bubble_assistant_text"
        android:textSize="15sp"
        android:lineSpacingMultiplier="1.3"
        android:layout_marginStart="10dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0" />

    <!--
        LLM stats caption: tokens · t/s · time
        Hidden until the response is fully streamed in.
    -->
    <TextView
        android:id="@+id/tv_llm_stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="5dp"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:alpha="0.65"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tv_message"
        app:layout_constraintStart_toEndOf="@id/tv_avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0" />

</androidx.constraintlayout.widget.ConstraintLayout>
