<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="end|top"
    android:paddingStart="80dp"
    android:paddingEnd="14dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!--
        Wrap bubble + meta in a vertical column so the speech-duration
        caption sits flush below the bubble, right-aligned.
    -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/tv_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bubble_user"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:textColor="@color/bubble_user_text"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.3" />

        <!-- Speech duration - hidden until the message is finalized -->
        <TextView
            android:id="@+id/tv_speech_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:alpha="0.65"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
