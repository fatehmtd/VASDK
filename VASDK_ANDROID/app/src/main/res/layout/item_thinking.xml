<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="14dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- AI avatar: pinned to top-left, mirrors the assistant item -->
    <TextView
        android:id="@+id/tv_avatar_thinking"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:text="AI"
        android:textColor="@color/white"
        android:textSize="9sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@drawable/bg_ai_avatar"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Bubble shell: same background as assistant, anchored right of avatar -->
    <LinearLayout
        android:id="@+id/thinking_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bubble_assistant"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:gravity="center_vertical"
        android:layout_marginStart="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_avatar_thinking">

        <View
            android:id="@+id/thinking_dot1"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/dot_indicator" />

        <View
            android:id="@+id/thinking_dot2"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/dot_indicator" />

        <View
            android:id="@+id/thinking_dot3"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/dot_indicator" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
