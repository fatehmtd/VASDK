# proto-file: vasdk/flow/agent.proto
# proto-message: vasdk.flow.Agent
#
# On the phone, before the LLM: "call mom" finds the contact by its name in the phone book,
# confirms, and calls; "turn on the flashlight" (or the torch, or the lights, on or off) switches
# it at once.
# Everything else goes on to the LLM as before.
# The app fills @contact from the phone book (ContactsEntity) and provides place_call and
# set_flashlight (Kotlin).
#   vasdk_agentc test agents/phone/agent.txtpb ../../../../agent-tests/phone/*.txtpb
schema_version: 1
name: "android-phone"
start_flow: "main"

session_params { name: "number" type: STRING sensitive: true }

# The phone book, by name: value = the number, spoken = the contact's name.
entity_types { name: "contact" dynamic: true matching { phonetic: true } list { } }

intents { name: "call" examples: ["call @contact", "phone @contact", "ring @contact", "dial @contact", "give @contact a call"] }

# The flashlight, at once and every time, rather than left to a small on-device model. The verbs
# come from the pack beside this file (${on}, ${off}); what's switched is this file's own set, and
# the commands are sets made of both: "turn on the lights", "switch the torch off", "flashlight on".
#   vasdk_agentc expand agents/phone/agent.txtpb flashlight_on   (every sentence they spell)
phrase_set_files: ["phrases.txtpb"]
phrase_sets { name: "light"   phrases: ["flashlight", "torch", "(light|lights)"] }
# "(turn|switch) _ ${light} on": any one word before the light, "turn my light on", "switch that torch on".
phrase_sets { name: "on_cmd"  phrases: ["${on} [the] ${light}", "(turn|switch|put) [the] ${light} on", "(turn|switch) _ ${light} on",
                                        "${light} on"] }
phrase_sets { name: "off_cmd" phrases: ["${off} [the] ${light}", "(turn|switch|put) [the] ${light} off", "(turn|switch) _ ${light} off",
                                        "${light} off"] }
intents { name: "flashlight_on"  examples: ["${on_cmd}"] }
intents { name: "flashlight_off" examples: ["${off_cmd}"] }

# The volume, a bounded NUMBER: from 0 to the phone's own maximum, which get_volume gives
# ($session.audio.max, read each time it's used). "louder" goes up a step and stops at the max
# (the at-limit handler below says so); "set the volume to 50" is clamped to it (out_of_range: CLAMP).
session_params { name: "audio" type: STRUCT }   # get_volume's result: {"current": 7, "max": 15}
session_params { name: "volume" type: NUMBER min: "0" max: "$session.audio.max" step: "1" out_of_range: CLAMP }
phrase_sets { name: "sound" phrases: ["[the] (volume|sound)"] }
intents { name: "volume_up"   examples: ["louder", "volume up", "${raise} ${sound}", "turn it up"] }
intents { name: "volume_down" examples: ["quieter", "softer", "volume down", "${lower} ${sound}", "turn it down"] }
intents { name: "set_volume"  examples: ["(set|put|turn) ${sound} to @sys.integer", "volume [to] @sys.integer"] }

# The screen's brightness, an ENUM: four levels in order, said in many ways ("dark", "half", "full"),
# each with the setting Android takes (attributes.level, 0 to 255). "brighter" moves one level up.
# The level starts at mid: the agent doesn't read the screen's own brightness. Matched exactly: with
# misspellings allowed, the word "brightness" itself would read as "brightest", so high.
entity_types { name: "brightness_level" matching { fuzzy: false } list {
  values { value: "dim"  synonyms: ["dark", "darkest", "lowest", "minimum"] attributes { fields { key: "level" value { number_value: 10 } } } }
  values { value: "low"  attributes { fields { key: "level" value { number_value: 64 } } } }
  values { value: "mid"  synonyms: ["medium", "middle", "half", "normal"] attributes { fields { key: "level" value { number_value: 140 } } } }
  values { value: "high" synonyms: ["bright", "brightest", "full", "maximum"] attributes { fields { key: "level" value { number_value: 255 } } } } } }
session_params { name: "brightness" type: ENUM entity: "@brightness_level" default { string_value: "mid" } }
phrase_sets { name: "screen" phrases: ["[the] (brightness|screen)"] }
intents { name: "brightness_up"   examples: ["[a bit] brighter", "${raise} ${screen}", "(brightness|screen) up", "make ${screen} brighter"] }
intents { name: "brightness_down" examples: ["[a bit] (dimmer|darker)", "${lower} ${screen}", "(brightness|screen) down", "dim ${screen}"] }
intents { name: "set_brightness"  examples: ["(set|put|make|turn) ${screen} [to] @brightness_level", "brightness [to] @brightness_level"] }

# Written in Kotlin (VasdkEngine.registerAgentTool): starts the call.
tools { name: "place_call" description: "Calls a phone number" }
# Written in Kotlin: turns the flashlight on or off ({"on": true|false}).
tools { name: "set_flashlight" description: "Turns the flashlight on or off" }
# Written in Kotlin: the music volume ({"current", "max"}), setting it ({"level"}), the screen's brightness ({"level"}, 0-255).
tools { name: "get_volume" description: "The music volume and its maximum" }
tools { name: "set_volume" description: "Sets the music volume" }
tools { name: "set_screen_brightness" description: "Sets the screen brightness, 0 to 255" }

flows {
  name: "main"
  start_page: "idle"
  pages {
    name: "idle"   # says nothing: the assistant is always listening
    routes {
      intent: "call"
      entity: "@contact"
      steps { set { key: "$session.number" value: "$entity" } }
      steps { ask { say { text: "Call $entity?" } expect { mode: YES_NO } } }
      target: "confirm"
    }
    routes { intent: "flashlight_on"
             steps { call_tool { name: "set_flashlight" args { key: "on" value: "true" } } }
             steps { say { text: "Flashlight on." } }
             target: "idle" }   # done: back to idle, so nothing more is asked (even mid-chat with the LLM)
    routes { intent: "flashlight_off"
             steps { call_tool { name: "set_flashlight" args { key: "on" value: "false" } } }
             steps { say { text: "Flashlight off." } }
             target: "idle" }
    # The volume: read the phone's (it may have changed with its buttons), move or set it, apply it.
    routes { intent: "volume_up"
             steps { call_tool { name: "get_volume" into: "$session.audio" } }
             steps { set { key: "$session.volume" value: "$session.audio.current" } }
             steps { increase { key: "$session.volume" } }   # at the max: at-limit, below, and nothing after it runs
             steps { call_tool { name: "set_volume" args { key: "level" value: "$session.volume" } } }
             steps { say { text: "Volume $session.volume." } }
             target: "idle" }
    routes { intent: "volume_down"
             steps { call_tool { name: "get_volume" into: "$session.audio" } }
             steps { set { key: "$session.volume" value: "$session.audio.current" } }
             steps { decrease { key: "$session.volume" } }
             steps { call_tool { name: "set_volume" args { key: "level" value: "$session.volume" } } }
             steps { say { text: "Volume $session.volume." } }
             target: "idle" }
    routes { intent: "set_volume" entity: "@sys.integer"
             steps { call_tool { name: "get_volume" into: "$session.audio" } }
             steps { set { key: "$session.volume" value: "$entity" } }   # CLAMP: 50 is the max
             steps { call_tool { name: "set_volume" args { key: "level" value: "$session.volume" } } }
             steps { branch { if: "$entity > $bounds.volume.max"
                              then { say { text: "Volume $session.volume, as loud as it goes." } }
                              else { say { text: "Volume $session.volume." } } } }
             target: "idle" }
    # The brightness: one level up or down, or the level named; the phone takes its attributes.level.
    routes { intent: "brightness_up"
             steps { increase { key: "$session.brightness" } }
             steps { call_tool { name: "set_screen_brightness" args { key: "level" value: "$bounds.brightness.attributes.level" } } }
             steps { say { text: "Brightness $session.brightness." } }
             target: "idle" }
    routes { intent: "brightness_down"
             steps { decrease { key: "$session.brightness" } }
             steps { call_tool { name: "set_screen_brightness" args { key: "level" value: "$bounds.brightness.attributes.level" } } }
             steps { say { text: "Brightness $session.brightness." } }
             target: "idle" }
    routes { intent: "set_brightness" entity: "@brightness_level"
             steps { set { key: "$session.brightness" value: "$entity" } }   # "dark" is stored as dim
             steps { call_tool { name: "set_screen_brightness" args { key: "level" value: "$bounds.brightness.attributes.level" } } }
             steps { say { text: "Brightness $session.brightness." } }
             target: "idle" }
    # Already at the bound: say which, and nothing else runs.
    handlers { event: "at-limit"
               steps { branch { if: "$nlu.intent : ('volume_up', 'volume_down')"
                                then { branch { if: "$bounds.volume.at_max" then { say { text: "That's as loud as it goes." } }
                                                                            else { say { text: "It's as quiet as it goes." } } } }
                                else { branch { if: "$bounds.brightness.at_max" then { say { text: "That's as bright as it goes." } }
                                                                                else { say { text: "That's as dim as it goes." } } } } } }
               target: "idle" }
    # No flash on this phone, the camera busy, or no permission to change the screen's brightness
    handlers { event: "tool-error"
               steps { branch { if: "$nlu.intent : ('flashlight_on', 'flashlight_off')"
                                then { say { text: "I couldn't use the flashlight." } }
                                else { say { text: "I couldn't change that: the app may need permission to modify system settings." } } } }
               target: "idle" }
  }
  pages {
    name: "confirm"
    routes { intent: "sys.yes"
             steps { call_tool { name: "place_call" args { key: "number" value: "$session.number" } } }
             steps { say { text: "Calling." } }
             target: "idle" }
    routes { intent: "sys.no" steps { say { text: "Okay, I won't call." } } target: "idle" }
  }
}
