# This file is used to ignore files which are generated
# ----------------------------------------------------------------------------

*~
*.autosave
*.a
*.core
*.moc
*.o
*.obj
*.orig
*.rej
*.so
*.so.*
*_pch.h.cpp
*_resource.rc
*.qm
.#*
*.*#
core
!core/
tags
.DS_Store
.directory
*.debug
Makefile*
*.prl
*.app
moc_*.cpp
ui_*.h
qrc_*.cpp
Thumbs.db
*.res
*.rc
/.qmake.cache
/.qmake.stash

# qtcreator generated files
*.pro.user*
*.qbs.user*
CMakeLists.txt.user*

# xemacs temporary files
*.flc

# Vim temporary files
.*.swp

# Visual Studio generated files
*.ib_pdb_index
*.idb
*.ilk
*.pdb
*.sln
*.suo
*.vcproj
*vcproj.*.*.user
*.ncb
*.sdf
*.opensdf
*.vcxproj
*vcxproj.*

# MinGW generated files
*.Debug
*.Release

# Python byte code
*.pyc

# Binaries
# --------
*.dll
*.exe

# Directories with generated files
.moc/
.obj/
.pch/
.rcc/
.uic/
/build*/
.vscode/
local-install/
local_install/

# Environment / secrets
.env
.env.*
!.env.example

# misc
*.onnx
*.tflite
*.zip
.claude/settings.local.json
scratchbook/
# Python wheel builds: the libraries bundle.py copies into the package, and build output
bindings/python/vasdk/*.dll
bindings/python/vasdk/*.dylib
# VASDK's messages, copied in by bundle.py (generated into build/bindings/python/vasdk)
bindings/python/vasdk/engine/
bindings/python/vasdk/flow/
bindings/python/vasdk/goal/
bindings/python/vasdk/nlu/
bindings/python/build/
# The Kotlin binding built by hand with Gradle (ctest builds it under build/)
bindings/kotlin/build/
bindings/kotlin/.gradle/
bindings/kotlin/.kotlin/
bindings/python/*.egg-info/
dist/
__pycache__/
# Conan: test_package/ build output, and the presets file "conan install ." writes
test_package/build/
CMakeUserPresets.json
