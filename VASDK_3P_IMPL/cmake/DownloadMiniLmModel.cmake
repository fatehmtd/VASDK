# --- Download all-MiniLM-L6-v2 (sentence encoder for intent understanding), int8 ONNX + vocab ---
if(CMAKE_SYSTEM_PROCESSOR MATCHES "arm64|aarch64|ARM64")
    set(_minilm_file "onnx/model_qint8_arm64.onnx")
else()
    set(_minilm_file "onnx/model_quint8_avx2.onnx")
endif()
set(MINILM_MODEL_DIR "${CMAKE_CURRENT_BINARY_DIR}/models/minilm")
set(_minilm_base "https://huggingface.co/sentence-transformers/all-MiniLM-L6-v2/resolve/main")
foreach(_pair "${_minilm_file}|model.onnx" "vocab.txt|vocab.txt")
    string(REPLACE "|" ";" _parts "${_pair}")
    list(GET _parts 0 _remote)
    list(GET _parts 1 _local)
    if(NOT EXISTS "${MINILM_MODEL_DIR}/${_local}")
        message(STATUS "Downloading MiniLM ${_local}...")
        file(DOWNLOAD "${_minilm_base}/${_remote}" "${MINILM_MODEL_DIR}/${_local}" STATUS _status)
        list(GET _status 0 _code)
        if(NOT _code EQUAL 0)
            file(REMOVE "${MINILM_MODEL_DIR}/${_local}")
            message(WARNING "MiniLM ${_local} not downloaded: ${_status}; the sentence encoder needs it at run time")
        endif()
    endif()
endforeach()
