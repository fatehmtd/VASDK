# Configure-time model downloads, read from the model manifest
# (VASDK_3P_IMPL/models/manifest.json): the same list, URLs and SHA-256s the model store downloads
# from at run time (docs/models.md). The Download*.cmake scripts call one function:
#
#   vasdk_download_model(<model id> DIRECTORY <dir> [STRIP <prefix>] [REQUIRED] [RESULT <variable>])
#
# - Each file of the model lands at <dir>/<path>, with <prefix> taken off the front of the
#   manifest's path: vasdk_download_model(parakeet DIRECTORY ${PARAKEET_MODEL_DIR} STRIP parakeet/).
#   A file that names a CPU ("arch") is fetched on that CPU only.
# - A file already there stays when its size matches and, below 32 MB, its SHA-256 too, so
#   switching between variants that share paths (gliner and gliner_multi) replaces the files.
#   Otherwise it downloads to <file>.part, is checked against the manifest's SHA-256 and renamed
#   into place; a file that doesn't match is deleted.
# - A gated model sends the Hugging Face token (HF_TOKEN, else the file `hf auth login` writes), and
#   only to huggingface.co. A model whose license needs reading first prints that license.
# - A failure warns, or stops the configure with REQUIRED, and sets <variable> to OFF.
#
# VASDK_MODEL_MANIFEST names another manifest: a mirror, or models of your own. The runtime takes
# the same file through `vasdk models --manifest` and `manifest_path`.

get_filename_component(_vasdk_default_model_manifest "${CMAKE_CURRENT_LIST_DIR}/../models/manifest.json" ABSOLUTE)
set(VASDK_MODEL_MANIFEST "${_vasdk_default_model_manifest}" CACHE FILEPATH
    "Model manifest the configure-time model downloads read (default: VASDK_3P_IMPL/models/manifest.json)")
unset(_vasdk_default_model_manifest)

# The CPU name the manifest uses: x86_64 or arm64 (else the processor name, which no file names).
function(_vasdk_model_architecture output)
    string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" processor)
    if(ANDROID)
        set(processor "${ANDROID_ABI}")
    elseif(APPLE AND CMAKE_OSX_ARCHITECTURES MATCHES "^(arm64|x86_64)$")
        set(processor "${CMAKE_OSX_ARCHITECTURES}")
    elseif(MSVC AND CMAKE_GENERATOR_PLATFORM)
        string(TOLOWER "${CMAKE_GENERATOR_PLATFORM}" processor)
    endif()
    if(processor MATCHES "^(arm64|aarch64|arm64-v8a)$")
        set(processor "arm64")
    elseif(processor MATCHES "^(x86_64|amd64|x64)$")
        set(processor "x86_64")
    endif()
    set(${output} "${processor}" PARENT_SCOPE)
endfunction()

# HF_TOKEN, else the token `hf auth login` saved; empty without one.
function(_vasdk_huggingface_token output)
    if(NOT "$ENV{HF_TOKEN}" STREQUAL "")
        set(${output} "$ENV{HF_TOKEN}" PARENT_SCOPE)
        return()
    endif()
    set(candidates "")
    if(NOT "$ENV{HF_HOME}" STREQUAL "")
        list(APPEND candidates "$ENV{HF_HOME}/token")
    endif()
    foreach(home "$ENV{HOME}" "$ENV{USERPROFILE}")
        if(NOT home STREQUAL "")
            list(APPEND candidates "${home}/.cache/huggingface/token")
        endif()
    endforeach()
    foreach(candidate IN LISTS candidates)
        if(EXISTS "${candidate}")
            file(READ "${candidate}" token)
            string(STRIP "${token}" token)
            set(${output} "${token}" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    set(${output} "" PARENT_SCOPE)
endfunction()

function(vasdk_download_model model_id)
    cmake_parse_arguments(PARSE_ARGV 1 ARG "REQUIRED" "DIRECTORY;STRIP;RESULT" "")
    if(NOT ARG_DIRECTORY)
        message(FATAL_ERROR "vasdk_download_model(${model_id}): DIRECTORY is required")
    endif()
    set(failure_level WARNING)
    if(ARG_REQUIRED)
        set(failure_level FATAL_ERROR)
    endif()
    if(ARG_RESULT)
        set(${ARG_RESULT} OFF PARENT_SCOPE)
    endif()

    if(NOT EXISTS "${VASDK_MODEL_MANIFEST}")
        message(FATAL_ERROR "VASDK_MODEL_MANIFEST: no file ${VASDK_MODEL_MANIFEST}")
    endif()
    file(READ "${VASDK_MODEL_MANIFEST}" manifest)
    string(JSON model_count ERROR_VARIABLE manifest_error LENGTH "${manifest}" models)
    if(manifest_error)
        message(FATAL_ERROR "${VASDK_MODEL_MANIFEST} is not a model manifest: ${manifest_error}")
    endif()
    set(model "")
    if(model_count GREATER 0)
        math(EXPR last_model "${model_count} - 1")
        foreach(index RANGE ${last_model})
            string(JSON identifier GET "${manifest}" models ${index} id)
            if(identifier STREQUAL model_id)
                string(JSON model GET "${manifest}" models ${index})
                break()
            endif()
        endforeach()
    endif()
    if(model STREQUAL "")
        message(FATAL_ERROR "Model '${model_id}' is not in ${VASDK_MODEL_MANIFEST}")
    endif()

    string(JSON license ERROR_VARIABLE no_license GET "${model}" license)
    string(JSON license_url ERROR_VARIABLE no_license_url GET "${model}" license_url)
    string(JSON gated ERROR_VARIABLE no_gated GET "${model}" gated)
    string(JSON requires_acceptance ERROR_VARIABLE no_acceptance GET "${model}" requires_acceptance)
    if(no_gated)
        set(gated OFF)
    endif()
    if(no_acceptance)
        set(requires_acceptance OFF)
    endif()
    set(token "")
    if(gated)
        _vasdk_huggingface_token(token)
    endif()
    _vasdk_model_architecture(architecture)

    set(all_present ON)
    set(downloaded "")
    string(JSON file_count LENGTH "${model}" files)
    math(EXPR last_file "${file_count} - 1")
    foreach(index RANGE ${last_file})
        string(JSON entry GET "${model}" files ${index})
        string(JSON file_architecture ERROR_VARIABLE no_architecture GET "${entry}" arch)
        if(NOT no_architecture AND NOT file_architecture STREQUAL architecture)
            continue()
        endif()
        string(JSON path GET "${entry}" path)
        string(JSON url GET "${entry}" url)
        string(JSON sha256 GET "${entry}" sha256)
        string(JSON size GET "${entry}" size)
        if(ARG_STRIP)
            string(LENGTH "${ARG_STRIP}" strip_length)
            string(SUBSTRING "${path}" 0 ${strip_length} head)
            if(NOT head STREQUAL ARG_STRIP)
                message(FATAL_ERROR "vasdk_download_model(${model_id}): ${path} does not start with ${ARG_STRIP}")
            endif()
            string(SUBSTRING "${path}" ${strip_length} -1 path)
        endif()
        set(destination "${ARG_DIRECTORY}/${path}")

        if(EXISTS "${destination}")
            file(SIZE "${destination}" present_size)
            set(keep OFF)
            if(present_size EQUAL size)
                set(keep ON)
                if(size LESS 33554432)
                    file(SHA256 "${destination}" present_sha256)
                    if(NOT present_sha256 STREQUAL sha256)
                        set(keep OFF)
                    endif()
                endif()
            endif()
            if(keep)
                continue()
            endif()
            message(STATUS "Model ${model_id}: ${path} differs from the manifest, downloading it again")
            file(REMOVE "${destination}")
        endif()

        set(options INACTIVITY_TIMEOUT 120 STATUS download_status)
        if(size GREATER 52428800)
            list(APPEND options SHOW_PROGRESS)
        endif()
        if(NOT token STREQUAL "" AND url MATCHES "^https://huggingface\\.co/")
            list(APPEND options HTTPHEADER "Authorization: Bearer ${token}")
        endif()
        if(size LESS 1048576)
            math(EXPR kilobytes "(${size} + 1023) / 1024")
            set(shown_size "${kilobytes} KB")
        else()
            math(EXPR megabytes "(${size} + 524288) / 1048576")
            set(shown_size "${megabytes} MB")
        endif()
        message(STATUS "Model ${model_id}: downloading ${path} (${shown_size})")
        get_filename_component(parent "${destination}" DIRECTORY)
        file(MAKE_DIRECTORY "${parent}")
        file(DOWNLOAD "${url}" "${destination}.part" ${options})
        list(GET download_status 0 download_code)
        list(GET download_status 1 download_message)
        if(download_code EQUAL 0)
            file(SHA256 "${destination}.part" received_sha256)
            if(received_sha256 STREQUAL sha256)
                file(RENAME "${destination}.part" "${destination}")
                list(APPEND downloaded "${path}")
                continue()
            endif()
            set(download_message "SHA-256 ${received_sha256}, the manifest pins ${sha256}")
        endif()
        file(REMOVE "${destination}.part")
        set(all_present OFF)
        set(hint "")
        if(gated)
            if(token STREQUAL "")
                set(hint " The model is gated: accept its terms at ${license_url}, then set HF_TOKEN or run `hf auth login`, and configure again.")
            else()
                set(hint " The model is gated: check that the account of your Hugging Face token accepted its terms at ${license_url}.")
            endif()
        endif()
        message(${failure_level} "Model ${model_id}: ${path} not downloaded from ${url}: ${download_message}.${hint}")
    endforeach()

    if(downloaded AND requires_acceptance)
        message(STATUS "Model ${model_id} is licensed ${license}: read ${license_url} before you ship it")
    endif()
    if(ARG_RESULT)
        set(${ARG_RESULT} ${all_present} PARENT_SCOPE)
    endif()
endfunction()
