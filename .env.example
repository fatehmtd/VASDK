# Copy this file to .env and fill in your values.
# .env is gitignored - never commit real keys.
#
# Priority order for LLM config:
#   1. CLI flags (--llm-api-key, --llm-endpoint, --llm-model)
#   2. These env vars (loaded from .env at startup)
#   3. Built-in defaults (endpoint falls back to OpenRouter)

# LLM API key - any of these are accepted (checked in order)
LLM_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# LLM endpoint (OpenAI-compatible)
# Default: https://openrouter.ai/api/v1/chat/completions
LLM_ENDPOINT=

# LLM model name
# Examples:
#   openai/gpt-4o
#   anthropic/claude-sonnet-4-5
#   qwen/qwen3-30b-a3b-instruct
LLM_MODEL=

# Phonon TTS (only when built with -DVASDK_BUILD_PHONON_TTS=ON)
# Voice: a file stem under models/phonon_tts/voices/ (see PHONON_TTS_VOICES at configure time),
# or "default". Pick a voice in the language the assistant speaks.
# Language: how numbers, dates, amounts and symbols are spelled out (en, fr, de, es, pt), or none.
# Rules: default, all (adds phones, times, dates), none, or a list such as numbers,currency.
# PHONON_TTS_VOICE=Easton
# PHONON_TTS_LANG=en
# PHONON_TTS_RULES=default
